# Groq API key for the AI tutor route (server-side only).
# Create a Groq API key and keep it out of client-side code.
GROQ_API_KEY=

# Optional: override the tutor model. Default: qwen/qwen3-32b
GROQ_MODEL=qwen/qwen3-32b

# Supabase project (create at https://supabase.com — free tier is enough for this)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
